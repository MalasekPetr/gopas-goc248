    {
      "key": "RiskRegister",
      "day": 2,
      "template": "GenericList",
      "createTitle": "RiskRegister",
      "url": "Lists/RiskRegister",
      "displayTitle": "Risk Register",
      "titleDisplayName": "N\u00e1zev rizika",
      "fields": [
        {
          "name": "RiskAsset",
          "displayName": "Aktivum",
          "type": "Lookup",
          "lookupList": "Lists/AssetRegister"
        },
        {
          "name": "Threat",
          "displayName": "Hrozba",
          "type": "Text"
        },
        {
          "name": "Vulnerability",
          "displayName": "Zranitelnost",
          "type": "Text"
        },
        {
          "name": "Likelihood",
          "displayName": "Pravd\u011bpodobnost",
          "type": "Number",
          "min": 1,
          "max": 5,
          "decimals": 0
        },
        {
          "name": "Impact",
          "displayName": "Dopad",
          "type": "Number",
          "min": 1,
          "max": 5,
          "decimals": 0
        },
        {
          "name": "RiskScore",
          "displayName": "M\u00edra rizika",
          "type": "Calculated",
          "resultType": "Number",
          "decimals": 0,
          "formula": "=[Likelihood]*[Impact]",
          "fieldRefs": [
            "Likelihood",
            "Impact"
          ]
        },
        {
          "name": "RiskOwner",
          "displayName": "Vlastn\u00edk rizika",
          "type": "User"
        },
        {
          "name": "Treatment",
          "displayName": "Zp\u016fsob zvl\u00e1d\u00e1n\u00ed",
          "type": "Choice",
          "choices": [
            "Sn\u00ed\u017eit",
            "P\u0159ijmout",
            "Vyhnout se",
            "Sd\u00edlet"
          ]
        },
        {
          "name": "TreatmentPlan",
          "displayName": "Pl\u00e1n zvl\u00e1d\u00e1n\u00ed",
          "type": "Note"
        },
        {
          "name": "ControlRef",
          "displayName": "Vazba na opat\u0159en\u00ed",
          "type": "Text"
        },
        {
          "name": "NextReview",
          "displayName": "Datum p\u0159\u00ed\u0161t\u00ed revize",
          "type": "DateOnly"
        },
        {
          "name": "RiskStatus",
          "displayName": "Stav",
          "type": "Choice",
          "choices": [
            "Identifikov\u00e1no",
            "V \u0159e\u0161en\u00ed",
            "P\u0159ijato",
            "Uzav\u0159eno"
          ]
        }
      ],
      "views": [
        {
          "title": "K revizi",
          "fields": [
            "LinkTitle",
            "RiskAsset",
            "RiskScore",
            "RiskOwner",
            "NextReview",
            "RiskStatus"
          ],
          "query": "<Where><And><Leq><FieldRef Name='NextReview' /><Value Type='DateTime'><Today /></Value></Leq><Neq><FieldRef Name='RiskStatus' /><Value Type='Text'>Uzav\u0159eno</Value></Neq></And></Where><OrderBy><FieldRef Name='RiskScore' Ascending='FALSE' /></OrderBy>"
        }
      ]
    },
    {
      "key": "IncidentLog",
      "day": 2,
      "template": "GenericList",
      "createTitle": "IncidentLog",
      "url": "Lists/IncidentLog",
      "displayTitle": "Incident log",
      "titleDisplayName": "N\u00e1zev",
      "fields": [
        {
          "name": "DetectedAt",
          "displayName": "Zji\u0161t\u011bno",
          "type": "DateTime"
        },
        {
          "name": "ClassifiedAt",
          "displayName": "Vyhodnoceno jako incident",
          "type": "DateTime"
        },
        {
          "name": "ReportDeadline",
          "displayName": "Lh\u016fta prvotn\u00edho hl\u00e1\u0161en\u00ed",
          "type": "Calculated",
          "resultType": "DateTime",
          "formula": "=[DetectedAt]+1",
          "fieldRefs": [
            "DetectedAt"
          ]
        },
        {
          "name": "Significant",
          "displayName": "V\u00fdznamn\u00fd dopad",
          "type": "Choice",
          "choices": [
            "ano",
            "ne",
            "posuzuje se"
          ]
        },
        {
          "name": "SignificanceBasis",
          "displayName": "Krit\u00e9rium v\u00fdznamnosti",
          "type": "Note"
        },
        {
          "name": "AffectedAssets",
          "displayName": "Dot\u010den\u00e1 aktiva",
          "type": "LookupMulti",
          "lookupList": "Lists/AssetRegister"
        },
        {
          "name": "Status",
          "displayName": "Stav",
          "type": "Choice",
          "choices": [
            "Nov\u00fd",
            "V \u0159e\u0161en\u00ed",
            "Nahl\u00e1\u0161eno",
            "Uzav\u0159eno"
          ]
        },
        {
          "name": "ReportDraft",
          "displayName": "Podklad pro hl\u00e1\u0161en\u00ed",
          "type": "URL"
        },
        {
          "name": "Evidence",
          "displayName": "D\u016fkazy",
          "type": "Note"
        }
      ]
    }
  ],
